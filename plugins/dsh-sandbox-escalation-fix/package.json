{
  "name": "dsh-plugin-sandbox-escalation-fix",
  "version": "0.2.0",
  "description": "Normalize redundant sandbox requests and malformed justifications in DeepSeek Harness tools, including PTC run_code",
  "keywords": [
    "deepseek-harness",
    "dsh",
    "plugin",
    "sandbox",
    "approval"
  ],
  "homepage": "https://github.com/inmny/dsh-sandbox-escalation-fix#readme",
  "bugs": {
    "url": "https://github.com/inmny/dsh-sandbox-escalation-fix/issues"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/inmny/dsh-sandbox-escalation-fix.git"
  },
  "type": "module",
  "main": "lib/index.js",
  "types": "lib/index.d.ts",
  "exports": {
    ".": {
      "types": "./lib/index.d.ts",
      "default": "./lib/index.js"
    },
    "./cordis.patch.yml": "./cordis.patch.yml",
    "./package.json": "./package.json"
  },
  "files": [
    "lib",
    "assets/teaser.png",
    "assets/teaser_add.png",
    "assets/teaser_justification.png",
    "cordis.patch.yml",
    "README.md",
    "LICENSE"
  ],
  "license": "MIT",
  "publishConfig": {
    "access": "public"
  },
  "engines": {
    "node": ">=24"
  },
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    }
  },
  "scripts": {
    "clean": "node -e \"require('node:fs').rmSync('lib', { recursive: true, force: true })\"",
    "build": "pnpm run clean && tsc -p tsconfig.json",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "test": "pnpm run build && node --test",
    "pack:check": "npm pack --dry-run",
    "prepack": "pnpm run build",
    "prepublishOnly": "pnpm test"
  },
  "peerDependencies": {
    "@deepseek-ai/cordis": "4.0.2",
    "@deepseek-ai/dsh-agent": "0.1.6-alpha.1",
    "@deepseek-ai/dsh-sandbox": "0.1.6-alpha.1",
    "@deepseek-ai/dsh-sandbox-policy": "0.1.6-alpha.1",
    "@deepseek-ai/dsh-tools": "0.1.6-alpha.1"
  },
  "devDependencies": {
    "@deepseek-ai/cordis": "4.0.2",
    "@deepseek-ai/dsh-agent": "0.1.6-alpha.1",
    "@deepseek-ai/dsh-sandbox": "0.1.6-alpha.1",
    "@deepseek-ai/dsh-sandbox-policy": "0.1.6-alpha.1",
    "@deepseek-ai/dsh-tools": "0.1.6-alpha.1",
    "@types/node": "24.10.1",
    "typescript": "5.9.3"
  },
  "packageManager": "pnpm@11.9.0"
}
