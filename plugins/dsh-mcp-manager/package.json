{
  "name": "dsh-mcp-manager",
  "version": "0.2.0",
  "description": "Manage DSH MCP servers as official config bundles that insert @deepseek-ai/dsh-mcp-client.",
  "type": "module",
  "private": true,
  "main": "./lib/index.js",
  "exports": {
    ".": "./lib/index.js",
    "./model": "./lib/model.cjs",
    "./client": "./lib/client.js",
    "./package.json": "./package.json"
  },
  "files": [
    "icon.svg",
    "lib/",
    "cordis.patch.yml"
  ],
  "license": "MIT",
  "engines": {
    "node": ">=20"
  },
  "peerDependencies": {
    "@deepseek-ai/dsh-mcp-client": "^0.2.0-rc.1",
    "@deepseek-ai/schemastery": "^3.18.4"
  },
  "dsh": {
    "bundle": {
      "patch": "cordis.patch.yml"
    },
    "client": {
      "inject": [
        "@deepseek-ai/dsh-client-locale",
        "@deepseek-ai/dsh-client-ui-plugin-manager"
      ],
      "platform": "web"
    },
    "engines": {
      "dsh": ">=0.2.0-rc.1"
    }
  },
  "icon": "./icon.svg",
  "scripts": {
    "embed": "node scripts/embed-model.mjs",
    "test": "node scripts/embed-model.mjs --check && node --test test/",
    "prepare": "node scripts/embed-model.mjs"
  },
  "dependencies": {
    "@deepseek-ai/schemastery": "^3.18.4"
  }
}
