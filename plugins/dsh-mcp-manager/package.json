{
  "name": "dsh-mcp-manager",
  "version": "0.2.1",
  "description": "Manage MCP connections with persistent records and dynamically owned official dsh-mcp-client instances.",
  "type": "module",
  "private": true,
  "main": "./lib/index.js",
  "exports": {
    ".": "./lib/index.js",
    "./model": "./lib/model.cjs",
    "./client": "./lib/client.js",
    "./locale/*.json": "./locale/*.json",
    "./package.json": "./package.json"
  },
  "files": [
    "icon.svg",
    "locale/",
    "lib/",
    "cordis.patch.yml"
  ],
  "keywords": [
    "deepseek-harness",
    "dsh",
    "dsh-plugin",
    "mcp"
  ],
  "license": "MIT",
  "engines": {
    "node": ">=20",
    "dsh": ">=0.2.0-rc.1"
  },
  "peerDependencies": {
    "@deepseek-ai/cordis-plugin-loader": "~1.0.6",
    "@deepseek-ai/dsh-storage-domain": ">=0.2.0-rc.1 <0.3.0",
    "@deepseek-ai/cordis": "^4.0.5",
    "@deepseek-ai/dsh-mcp-client": "^0.2.0-rc.1",
    "@deepseek-ai/schemastery": "^3.18.4"
  },
  "dsh": {
    "bundle": {
      "patch": "cordis.patch.yml"
    },
    "client": {
      "inject": [
        "@deepseek-ai/dsh-client-locale",
        "@deepseek-ai/dsh-client-ui-plugin-manager"
      ],
      "platform": "web"
    },
    "engines": {
      "dsh": ">=0.2.0-rc.1"
    }
  },
  "icon": "./icon.svg",
  "scripts": {
    "embed": "node scripts/embed-model.mjs",
    "test": "node scripts/embed-model.mjs --check && node --test test/"
  },
  "devDependencies": {
    "@deepseek-ai/dsh-storage-json": ">=0.2.0-rc.1 <0.3.0"
  },
  "dependencies": {
    "@deepseek-ai/schemastery": "^3.18.4"
  }
}
