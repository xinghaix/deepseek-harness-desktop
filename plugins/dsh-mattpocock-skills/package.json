{
  "name": "dsh-mattpocock-skills",
  "version": "1.3.1",
  "description": "Port of Matt Pocock's 38 engineering & productivity skills for DeepSeek Harness (27 core enabled by default, 11 optional extensions, and automatic ~/.dsh/skills symlink sync).",
  "type": "module",
  "main": "./lib/index.js",
  "icon": "./icon.svg",
  "exports": {
    ".": "./lib/index.js",
    "./client": "./lib/client.js",
    "./icon": "./icon.svg",
    "./locale/*.json": "./locale/*.json",
    "./dsh-plugin.json": "./dsh-plugin.json",
    "./package.json": "./package.json"
  },
  "files": [
    "icon.svg",
    "dsh-plugin.json",
    "cordis.patch.yml",
    "locale/",
    "lib/",
    "assets/",
    "LICENSE",
    "README.md"
  ],
  "keywords": [
    "deepseek-harness",
    "dsh",
    "dsh-plugin",
    "skills",
    "mattpocock",
    "tdd",
    "architecture",
    "domain-modeling"
  ],
  "license": "MIT",
  "engines": {
    "node": ">=20",
    "dsh": ">=0.2.0-rc.1"
  },
  "peerDependencies": {
    "@deepseek-ai/cordis": "^4.0.5",
    "@deepseek-ai/dsh-skill": ">=0.2.0-rc.1 <0.3.0",
    "@deepseek-ai/schemastery": "^3.18.4"
  },
  "dsh": {
    "bundle": {
      "patch": "cordis.patch.yml"
    },
    "client": {
      "platform": "web",
      "immediately": true,
      "inject": [
        "@deepseek-ai/dsh-client-locale",
        "@deepseek-ai/dsh-client-ui-settings",
        "@deepseek-ai/dsh-client-ui-plugin-manager"
      ]
    },
    "engines": {
      "dsh": ">=0.2.0-rc.1"
    }
  },
  "scripts": {
    "test": "node --test tests/*.test.mjs"
  }
}
